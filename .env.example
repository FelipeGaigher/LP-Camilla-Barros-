# =============================================================================
# Dra. Camilla Barros — variaveis de ambiente
# =============================================================================
# Copie este arquivo para `.env.local` e preencha. `.env*` esta no .gitignore.
#
# Em producao as mesmas variaveis ficam no painel da Vercel, em
# Settings > Environment Variables.

# -----------------------------------------------------------------------------
# Banco — Neon Postgres (OBRIGATORIO)
# -----------------------------------------------------------------------------
# Use a connection string POOLED do Neon (a que tem "-pooler" no host).
# Console do Neon > Branches > Connection Details.
DATABASE_URL=postgresql://user:senha@host-pooler.regiao.aws.neon.tech/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Vercel Blob — fotos e video (OBRIGATORIO pra upload funcionar)
# -----------------------------------------------------------------------------
# Painel da Vercel > Storage > Blob > conectar ao projeto. O token aparece
# sozinho nas env vars de producao; local, cole aqui.
# Sem ele o site funciona, mas o botao de enviar arquivo falha.
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Brevo — aviso de lead e recuperacao de senha
# -----------------------------------------------------------------------------
# Sem BREVO_API_KEY nada quebra: o envio vira no-op e so registra no log.
# https://app.brevo.com > SMTP & API > API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=nao-responda@dracamillabarros.com.br
BREVO_SENDER_NAME=Dra. Camilla Barros

# Quem recebe o aviso de contato novo. Vazio = ninguem e avisado.
CONTACT_EMAIL=

# URL publica do site. Entra no link de recuperacao de senha do e-mail.
APP_URL=http://localhost:5173

# Segredo do HMAC dos tokens de recuperacao. Gere um proprio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESET_TOKEN_HMAC_SECRET=

# -----------------------------------------------------------------------------
# Admin inicial — lido apenas pelo `npm run seed`
# -----------------------------------------------------------------------------
ADMIN_USER=camilla
ADMIN_PASSWORD=troque-esta-senha
# Sem e-mail o "esqueci minha senha" fica indisponivel.
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Frontend — o Vite so expoe variaveis com prefixo VITE_
# -----------------------------------------------------------------------------
# Edicao inline na propria pagina (clicar no texto e digitar). Com `false`,
# sobra so o painel em /gestao.
VITE_ENABLE_INLINE_CMS=true
