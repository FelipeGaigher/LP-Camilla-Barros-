    "dev:full": "node scripts/dev-server.js --full",
    "build": "npm run check:datas && vite build && npm run build:seo",
    "check:datas": "node scripts/check-datas.js",
    "test": "npm run check:datas && npm run test:brt && npm run test:slots",
